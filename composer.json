{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "fklavyenet/webblocks-cms",
    "type": "library",
    "description": "WebBlocks CMS",
    "keywords": ["webblocks", "cms", "blocks", "laravel"],
    "license": "MIT",
    "authors": [
        {
            "name": "Fklavyenet"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^2.4",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "WebBlocks\\Cms\\Plugins\\WebBlocksUiManager\\": "plugins/webblocks-ui-manager/src/",
            "WebBlocks\\Cms\\": "packages/webblocks-cms/src/",
            "WebBlocks\\Cms\\Database\\Seeders\\": "packages/webblocks-cms/database/seeders/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Project\\": "project/"
        },
        "exclude-from-classmap": [
            "app/Models/User.php",
            "app/Http/Controllers/Controller.php",
            "app/Providers/AppServiceProvider.php",
            "database/seeders/DatabaseSeeder.php",
            "database/factories/UserFactory.php",
            "project/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force"
        ],
        "dev": [
            "@php artisan serve"
        ],
        "native:doctor": [
            "@php artisan webblocks:doctor-native-local"
        ],
        "native:smoke": [
            "@php artisan webblocks:smoke-native-local"
        ],
        "release:prepare": [
            "scripts/release/prepare.sh"
        ],
        "release:publish-update": [
            "scripts/release/publish-update.sh"
        ],
        "format": [
            "vendor/bin/pint"
        ],
        "format:test": [
            "vendor/bin/pint --test",
            "@php scripts/check-php-indentation.php"
        ],
        "format:changed": [
            "bash scripts/format-changed.sh"
        ],
        "format:touched": [
            "@format:changed"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test --exclude-group=legacy"
        ],
        "test:admin-smoke": [
            "@php artisan config:clear --ansi",
            "@php artisan test tests/Feature/Admin/AdminDashboardRouteTest.php tests/Feature/Admin/AdminSidebarNavigationTest.php tests/Feature/Admin/SharedAdminPartialPackageViewTest.php --exclude-group=legacy --stop-on-failure"
        ],
        "test:admin-translations": [
            "@php artisan webblocks:admin-translation-audit --locale=de --baseline=packages/webblocks-cms/resources/translation-quality/admin-translation-audit-baseline.json --strict",
            "@php artisan webblocks:admin-translation-audit --locale=tr --baseline=packages/webblocks-cms/resources/translation-quality/admin-translation-audit-baseline.json --strict"
        ],
        "test:artifacts": [
            "@php artisan config:clear --ansi",
            "@php artisan test tests/Feature/ReleasePackageBoundaryTest.php --exclude-group=legacy --stop-on-failure"
        ],
        "test:full": [
            "@php artisan config:clear --ansi",
            "@php artisan test --exclude-group=legacy"
        ],
        "test:install": [
            "@php artisan config:clear --ansi",
            "@php artisan test tests/Feature/PackageConsumerInstallCommandTest.php tests/Feature/PackageConsumerPartialInstallRepairTest.php tests/Feature/PackageConsumerInstallAuthTest.php tests/Feature/PackageFreshInstallMigrationTest.php --exclude-group=legacy --stop-on-failure"
        ],
        "test:legacy-bridge": [
            "@php artisan config:clear --ansi",
            "@php artisan test tests/Unit/System/Updates/LegacyRootManagedUpdateCompatibilityTest.php --group=legacy --stop-on-failure"
        ],
        "test:package": [
            "@php artisan config:clear --ansi",
            "@php artisan test tests/Feature/ComposerPackageMetadataTest.php tests/Feature/PackageServiceProviderBootstrapTest.php tests/Feature/PackageRuntimeSlicesTest.php tests/Feature/PackageWrapperCleanupTest.php tests/Feature/Console/PackageStatusCommandTest.php --exclude-group=legacy --stop-on-failure"
        ],
        "test:release-fast": [
            "@php artisan config:clear --ansi",
            "@php artisan test tests/Unit/System/Updates/UpdateMigrationRunnerTest.php tests/Unit/System/Updates/UpdatePackageExtractorTest.php tests/Feature/Admin/SystemUpdatesTest.php tests/Feature/PageTranslationParentKeyUpdateMigrationTest.php tests/Feature/PackageConsumerInstallCommandTest.php tests/Feature/PackageServiceProviderBootstrapTest.php tests/Feature/ReleasePackageBoundaryTest.php --exclude-group=legacy --stop-on-failure"
        ],
        "test:update": [
            "@php artisan config:clear --ansi",
            "@php artisan test tests/Unit/System/Updates/UpdateMigrationRunnerTest.php tests/Unit/System/Updates/UpdatePackageExtractorTest.php tests/Unit/System/Updates/UpdateServerClientTest.php tests/Unit/System/InstalledVersionStoreTest.php tests/Feature/Admin/SystemUpdatesTest.php tests/Feature/PageTranslationParentKeyUpdateMigrationTest.php tests/Feature/System/SystemBackupRestoreManagerTest.php --exclude-group=legacy --stop-on-failure"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "WebBlocks\\Cms\\WebBlocksCmsServiceProvider"
            ],
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
