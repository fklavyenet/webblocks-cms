{
  "preset": "laravel",
  "rules": {
    "array_indentation": false,
    "array_syntax": {
      "syntax": "short"
    },
    "binary_operator_spaces": {
      "default": "single_space"
    },
    "method_chaining_indentation": false,
    "no_unused_imports": true,
    "ordered_imports": {
      "sort_algorithm": "alpha"
    },
    "phpdoc_indent": false,
    "single_quote": true,
    "statement_indentation": false
  }
}
