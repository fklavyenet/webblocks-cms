# Copy to deploy/.env and fill in, then from the deploy/ directory run:
#   docker compose up -d --build

# Public domain that points (A/AAAA record) at this VPS. Caddy issues a
# Let's Encrypt certificate for it automatically.
DEMO_DOMAIN=demo.example.com

# Public demo admin. Anyone can sign in with these, so keep them demo-only.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=change-me
