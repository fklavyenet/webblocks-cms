                    "key": "important-notes-fallback",
                    "type": "callout",
                    "variant": "warning",
                    "translations": {
                      "en": {
                        "title": "Missing classes stay visible",
                        "content": "Unknown <code>wb-icon-*</code> classes fall back to <code>help-circle</code> instead of rendering a blank square."
