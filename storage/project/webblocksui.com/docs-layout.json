                      {
                        "key": "cluster-card",
                        "type": "card",
                        "translations": {
                          "en": {
                            "title": "Cluster",
                            "content": "Wraps inline items and keeps compact controls from breaking awkwardly."
                          }
                        }
                      },
                      {
                        "key": "split-card",
                        "type": "card",
                        "translations": {
                          "en": {
                            "title": "Split",
                            "content": "Grows left. Action stays fixed on the right."
                          }
                        }
                      }
                    ]
                  },
                  {
                    "key": "simple-grid-and-flow-code",
                    "type": "code",
                    "settings": {
                      "language": "html"
                    },
                    "translations": {
                      "en": {
                        "content": "<div class=\"wb-grid-2\">...</div>\n<div class=\"wb-grid-auto\">...</div>\n<div class=\"wb-split\">\n  <div>grows</div>\n  <button class=\"wb-btn wb-btn-sm\">fixed side</button>\n</div>"
                      }
                    }
                  }
                ]
              }
            ]
