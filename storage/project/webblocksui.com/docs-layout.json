                  "width": "lg",
                  "layout_name": "Layout intro container"
                },
                "children": [
                  {
                    "key": "layout-title",
                    "type": "header",
                    "variant": "h1",
                    "url": "layout",
                    "settings": {
                      "anchor": "layout"
                    },
                    "translations": {
                      "en": {
                        "title": "Layout"
                      }
                    }
                  },
                  {
                    "key": "layout-intro-copy",
                    "type": "rich-text",
                    "translations": {
                      "en": {
                        "content": "<p>Layout is where page width, structural flow, navigation frame, and shell choice live. If you are asking about <code>wb-container</code>, <code>wb-grid-*</code>, <code>wb-row</code>, navbar, sidebar, or dashboard/content/auth shells, start here.</p>"
                      }
                    }
                  },
                  {
                    "key": "layout-toc",
                    "type": "toc",
                    "translations": {
                      "en": {
                        "title": "On this page"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "key": "base-composition-primitives-section",
            "type": "section",
            "settings": {
              "layout_name": "Base composition primitives"
            },
            "children": [
              {
                "key": "base-composition-primitives-container",
                "type": "container",
                "settings": {
                  "width": "lg",
                  "layout_name": "Base composition primitives container"
                },
                "children": [
                  {
                    "key": "base-composition-primitives-heading",
                    "type": "header",
                    "variant": "h2",
                    "url": "base-composition-primitives",
                    "settings": {
                      "anchor": "base-composition-primitives"
                    },
                    "translations": {
                      "en": {
                        "title": "Base composition primitives"
                      }
                    }
                  },
                  {
                    "key": "base-composition-primitives-table",
                    "type": "table",
                    "variant": "header-row",
                    "translations": {
                      "en": {
                        "content": "Class | Use it for | Why it matters\nwb-container* | Page width and horizontal padding | Keeps content measure consistent.\nwb-section* | Major vertical bands | Defines outer page rhythm.\nwb-stack* | Vertical flow | Handles repeated spacing without one-off margins.\nwb-cluster* | Wrapped inline groups | Good for actions, chips, compact controls.\nwb-split | Two-sided layouts | Lets the first child grow and the last child stay fixed.\nwb-grid* | Simple repeated columns | Fast 2/3/4-column and auto-fill layout."
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "key": "simple-grid-and-flow-section",
