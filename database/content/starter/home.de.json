{
  "schema": "webblocks.cms.starter-content.v1",
  "slots": {
    "main": [
      {
        "type": "section",
        "children": [
          {
            "type": "container",
            "settings": {
              "flow": "stack"
            },
            "children": [
              {
                "type": "cluster",
                "settings": {
                  "gap": "md",
                  "wrap": "nowrap",
                  "items_alignment": "start"
                },
                "children": [
                  {
                    "type": "image",
                    "media": "logo-mark.png"
                  },
                  {
                    "type": "content_header",
                    "translations": {
                      "eyebrow": "Deine Website ist installiert",
                      "title": "WebBlocks CMS",
                      "subtitle": "Diese Seite ist kein Platzhalter-Bildschirm. Sie ist gewöhnlicher Inhalt, der bei der Installation angelegt wurde – melde dich an, öffne sie im Seiteneditor und mach sie zu deiner eigenen."
                    }
                  }
                ]
              },
              {
                "type": "cluster",
                "settings": {
                  "gap": "sm"
                },
                "children": [
                  {
                    "type": "button_link",
                    "settings": {
                      "url": "/webadmin",
                      "variant": "primary"
                    },
                    "translations": {
                      "title": "Admin öffnen"
                    }
                  },
                  {
                    "type": "button_link",
                    "settings": {
                      "url": "https://cms.webblocksui.com",
                      "variant": "secondary",
                      "target": "_blank"
                    },
                    "translations": {
                      "title": "Dokumentation lesen"
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "children": [
          {
            "type": "container",
            "settings": {
              "flow": "stack"
            },
            "children": [
              {
                "type": "feature-grid",
                "translations": {
                  "title": "Womit anfangen",
                  "subtitle": "Drei Dinge, die sich vor der Veröffentlichung lohnen."
                },
                "children": [
                  {
                    "type": "feature-item",
                    "translations": {
                      "title": "Diese Seite bearbeiten",
                      "content": "Der Bereich Seiten im Admin listet diese Seite unter / auf. Öffne sie im Block-Editor: Jeder Abschnitt hier ist ein Block, den du umschreiben, umsortieren oder löschen kannst."
                    }
                  },
                  {
                    "type": "feature-item",
                    "translations": {
                      "title": "Mit Blöcken bauen",
                      "content": "Abschnitte, Container, Raster und Karten ergeben ein Layout. Füge einen Block hinzu, wähle seinen Slot und veröffentliche ihn, sobald der Inhalt fertig ist."
                    }
                  },
                  {
                    "type": "feature-item",
                    "translations": {
                      "title": "Eigene Medien hinzufügen",
                      "content": "Lade Logos und Bilder in die Mediathek hoch und verknüpfe sie mit Bild-, Galerie- und Hero-Blöcken, statt Dateipfade fest zu verdrahten."
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "children": [
          {
            "type": "container",
            "settings": {
              "flow": "stack"
            },
            "children": [
              {
                "type": "cta",
                "settings": {
                  "variant": "muted"
                },
                "translations": {
                  "title": "Bereit, diese Seite zu ersetzen?",
                  "content": "Nichts hier ist geschützt. Lösche diese Starter-Blöcke, wann immer du willst, oder behalte einen als Vorlage für deine eigenen Abschnitte."
                },
                "children": [
                  {
                    "type": "button_link",
                    "settings": {
                      "url": "/webadmin/pages",
                      "variant": "primary"
                    },
                    "translations": {
                      "title": "Seiteneditor öffnen"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
